// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

/// Where a user's identity comes from. Stored per row, not per app: local and
/// external logins coexist, so this is never a global mode.
enum AuthProvider {
  LOCAL
  CLERK
  GOOGLE
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(100)
  /// Null for provider-backed users — they never have a password here.
  password String? @db.VarChar(255)
  name     String? @db.VarChar(100)

  provider AuthProvider @default(LOCAL)
  /// Provider's own user id (Clerk `sub`, Google `sub`). Kept separate from
  /// `id` so foreign keys stay numeric and provider-independent.
  externalId String? @unique @map("external_id") @db.VarChar(191)

  role   Role    @default(USER)
  avatar String? @db.VarChar(255)

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provider, externalId])
  @@map("users")
}

/// One row per issued refresh token. Existing as a table is what makes
/// revocation possible at all — access tokens alone cannot be withdrawn.
model RefreshToken {
  id String @id @default(uuid())

  /// SHA-256 of the token, never the token itself: a database leak must not
  /// hand over live sessions.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  /// Set when this token is rotated. If an already-rotated token is presented
  /// again, it was replayed — treat as theft and revoke the whole family.
  replacedById String? @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
