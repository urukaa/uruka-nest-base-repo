# Copy to .env and fill in. Every variable below without a default is required
# at boot except the R2_* group, which is validated on first use.

# --- Toggles -----------------------------------------------------------------
IS_VO1D_PRODUCTION=mboten
IS_VO1D_TESTING=nggih

# --- App ---------------------------------------------------------------------
PORT=8000

# Only required when IS_VO1D_TESTING=mboten (request signing enforced).
# Safe to leave empty for local development.
APP_NAME=
# openssl rand -hex 32
APP_KEY=
APP_SECRET=

# Comma-separated. Empty = allow localhost only.
ALLOWED_IPS=
# Comma-separated CORS origins. Empty = http://127.0.0.1:3000
ORIGINS=

# --- Rate limit & signature window -------------------------------------------
# Default 60 (1 menit)
SIGNATURE_WINDOW_SECONDS=
# Default 100 request / 60 seconds.
THROTTLE_TTL_SECONDS=
THROTTLE_LIMIT=

# Set only when running behind a reverse proxy (nginx, Cloudflare). Accepts an
# express `trust proxy` value, e.g. 1. Leaving it empty is the safe default:
# enabling it makes X-Forwarded-For spoofable, and the IP allowlist trusts it.
TRUST_PROXY=

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/base?schema=public

# --- Auth --------------------------------------------------------------------
# openssl rand -hex 64
JWT_SECRET=
# Access token. Seconds (3600) or an ms-style duration (15m, 1h).
# Keep it short — access tokens cannot be revoked, only outlived.
JWT_EXPIRE_IN=3600

# Refresh token, in seconds. Default 2592000 (30 days). Long is fine here:
# refresh tokens live in the database and can be revoked.
REFRESH_EXPIRE_IN=

# --- External auth provider (optional) ----------------------------------------
# Works with any provider issuing RS256 JWTs over JWKS: Clerk, Auth0, Supabase,
# Firebase, Cognito, Keycloak. Leave JWKS_URL empty and the route stays off.
#
# Clerk: create a JWT template in the dashboard, otherwise the token carries
# only `sub` and the username claim below will be missing.
AUTH_EXTERNAL_JWKS_URL=
AUTH_EXTERNAL_ISSUER=

# Clerk puts the calling origin in `azp`; Auth0/Cognito use `aud`. Fill in
# whichever your provider issues — leaving both empty skips the check, which
# Clerk's docs call out as a CSRF exposure.
AUTH_EXTERNAL_AUTHORIZED_PARTIES=
AUTH_EXTERNAL_AUDIENCE=

# Which claim becomes the username, and which AuthProvider value is stored.
AUTH_EXTERNAL_USERNAME_CLAIM=email
AUTH_EXTERNAL_NAME_CLAIM=name
AUTH_EXTERNAL_PROVIDER=CLERK

# --- Cloudflare R2 (optional; required only if you use R2Service) -------------
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_MEDIA_URL=
R2_REGION=auto
